.nh
.TH "HASP" "1" "Sep 2026" "hasp" "hasp Manual"

.SH NAME
hasp-find - Identify a resource from a partial clue


.SH SYNOPSIS
\fBhasp find [flags]\fP


.SH DESCRIPTION
Identify a resource from a partial clue


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for find


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--key-dir\fP="~/.ssh"
	key directory (default ~/.ssh)

.PP
\fB--no-color\fP[=false]
	disable ANSI color in human output

.PP
\fB--verbose\fP[=false]
	enable diagnostic logging to stderr

.PP
\fB--yes\fP[=false]
	consent to apply a write non-interactively


.SH SEE ALSO
\fBhasp(1)\fP, \fBhasp-find-host(1)\fP, \fBhasp-find-key(1)\fP, \fBhasp-find-profile(1)\fP
