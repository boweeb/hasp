.nh
.TH "HASP" "1" "Sep 2026" "hasp" "hasp Manual"

.SH NAME
hasp-check-key - Report duplicate, incomplete, or unaffiliated keys


.SH SYNOPSIS
\fBhasp check key [flags]\fP


.SH DESCRIPTION
Report duplicate, incomplete, or unaffiliated keys


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for key


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--key-dir\fP="~/.ssh"
	key directory (default ~/.ssh)

.PP
\fB--no-color\fP[=false]
	disable ANSI color in human output

.PP
\fB--verbose\fP[=false]
	enable diagnostic logging to stderr

.PP
\fB--yes\fP[=false]
	consent to apply a write non-interactively


.SH SEE ALSO
\fBhasp-check(1)\fP
