.nh
.TH "HASP" "1" "Sep 2026" "hasp" "hasp Manual"

.SH NAME
hasp - hasp manages SSH identity: keys, hosts, and profiles on one laptop.


.SH SYNOPSIS
\fBhasp [flags]\fP


.SH DESCRIPTION
hasp manages SSH identity: keys, hosts, and profiles on one laptop.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for hasp

.PP
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--key-dir\fP="~/.ssh"
	key directory (default ~/.ssh)

.PP
\fB--no-color\fP[=false]
	disable ANSI color in human output

.PP
\fB--verbose\fP[=false]
	enable diagnostic logging to stderr

.PP
\fB--yes\fP[=false]
	consent to apply a write non-interactively


.SH SEE ALSO
\fBhasp-adopt(1)\fP, \fBhasp-check(1)\fP, \fBhasp-edit(1)\fP, \fBhasp-find(1)\fP, \fBhasp-list(1)\fP, \fBhasp-new(1)\fP, \fBhasp-release(1)\fP, \fBhasp-show(1)\fP, \fBhasp-version(1)\fP
