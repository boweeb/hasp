.nh
.TH "HASP" "1" "Sep 2026" "hasp" "hasp Manual"

.SH NAME
hasp-adopt - Move an unmanaged resource into managed territory


.SH SYNOPSIS
\fBhasp adopt [flags]\fP


.SH DESCRIPTION
Move an unmanaged resource into managed territory


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for adopt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--json\fP[=false]
	machine-readable output

.PP
\fB--key-dir\fP="~/.ssh"
	key directory (default ~/.ssh)

.PP
\fB--no-color\fP[=false]
	disable ANSI color in human output

.PP
\fB--verbose\fP[=false]
	enable diagnostic logging to stderr

.PP
\fB--yes\fP[=false]
	consent to apply a write non-interactively


.SH SEE ALSO
\fBhasp(1)\fP, \fBhasp-adopt-host(1)\fP, \fBhasp-adopt-key(1)\fP, \fBhasp-adopt-profile(1)\fP
