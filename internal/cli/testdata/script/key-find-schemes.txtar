# Multi-scheme find key (M3.6.3, T36/T48/T50): all four registered schemes, both directions of
# the MD5 shape's own collision (exit criterion 1a), T50's case-and-punctuation folding at
# compare time, and T48's explicit-warning-over-silent-miss path.
#
# id_rsa_legacy is testdata/keys/rsa-pem-plain-pub verbatim (unencrypted, tdd.md §12's own
# committed vectors), id_ed25519 is testdata/keys/ed25519-openssh-plain-pub verbatim, and
# id_rsa_old is testdata/keys/rsa-pem-encrypted-nopub verbatim (legacy PEM, encrypted, no .pub —
# T1's undecidable row, always unevaluable for aws-created-rsa since find never prompts).
mkdir $WORK/home/.ssh
cp rsa.pem $WORK/home/.ssh/id_rsa_legacy
cp ed25519.pem $WORK/home/.ssh/id_ed25519
cp rsa-encrypted.pem $WORK/home/.ssh/id_rsa_old

# aws-created-rsa (SHA-1, 40 hex digits): confirmed provenance (T36).
exec hasp find key 97:47:11:3c:af:56:47:b3:f9:a9:89:36:6d:ca:be:0b:33:a0:05:f7 --key-dir $WORK/home/.ssh
stdout 'id_rsa_legacy'
stdout 'aws-created-rsa'
stdout 'aws-ec2-created'
stdout 'confirmed'
stderr 'aws-created-rsa could not be evaluated for 1 encrypted key'

exec hasp find key 97:47:11:3c:af:56:47:b3:f9:a9:89:36:6d:ca:be:0b:33:a0:05:f7 --key-dir $WORK/home/.ssh --json
stdout '"kind": "key.find"'
stdout '"scheme=aws-created-rsa"'
stdout '"id": "aws-ec2-created"'
stdout '"confidence": "confirmed"'
stdout '"warnings"'

# The MD5 shape's own collision, both directions (roadmap.md exit criterion 1a): aws-imported-rsa
# is confirmed provenance, legacy-ssh-md5 is only possible — same key, same 47-character shape,
# different value, different confidence.
exec hasp find key a8:e7:45:95:5f:a3:f0:b1:79:6c:c2:f1:d2:80:57:ea --key-dir $WORK/home/.ssh
stdout 'id_rsa_legacy'
stdout 'aws-imported-rsa'
stdout 'confirmed'

exec hasp find key 34:29:f4:da:3c:db:49:4b:35:ba:c1:c2:cd:2e:75:a8 --key-dir $WORK/home/.ssh
stdout 'id_rsa_legacy'
stdout 'legacy-ssh-md5'
stdout 'possible'

# ssh-native-sha256 (base64, full 43-character shape): possible, no AWS provenance signal.
exec hasp find key SHA256:lqTGTP6KJSQptQJQEZj7scuX7jLWFfb0qoAHTT1IpPA --key-dir $WORK/home/.ssh
stdout 'id_ed25519'
stdout 'ssh-native-sha256'
stdout 'possible'

# T50: case mangled AND punctuation (hyphens) injected into a base64 fragment — J2's literal
# "punctuation and case shouldn't matter" promise, folded at compare time without corrupting
# fpscheme.Normalize's own shape-preserving output.
exec hasp find key sha256:LQtg-TP6K-JSQp --key-dir $WORK/home/.ssh
stdout 'id_ed25519'

# T48: a SHA-1-shaped clue with no real match still surfaces the warning for id_rsa_old, which can
# never be evaluated against aws-created-rsa — find never prompts for a passphrase — and the
# result table carries no false match to go with it.
exec hasp find key 0000000000000000000000000000000000000a --key-dir $WORK/home/.ssh
stdout '^NAME'
! stdout 'id_rsa_old'
! stdout 'id_rsa_legacy'
! stdout 'id_ed25519'
stderr 'aws-created-rsa could not be evaluated for 1 encrypted key'
stderr 'never prompts for a passphrase'

