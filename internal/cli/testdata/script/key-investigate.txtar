# --investigate on show key and list key (M3.6.4, tdd.md §18, roadmap.md §5.6). id_rsa is
# testdata/keys/rsa-openssh-encrypted-pub + .pub verbatim (OpenSSH format, encrypted, public half
# derivable from the embedded unencrypted public key — T1); id_ed25519 is the same inline,
# throwaway OpenSSH ed25519 key key-list.txtar and key-find-schemes.txtar already embed — plain
# (unencrypted), so its public half is derivable with no .pub sidecar at all.
#
# testscript's exec never attaches a TTY (new-key.txtar's own comment: "the default for a
# testscript exec") and no `stdin` directive redirects one here, so every exec below is exactly
# roadmap.md §5.6 exit criterion 5's own scenario: `hasp show key --investigate --json </dev/null`.
mkdir $WORK/home/.ssh
cp rsa-encrypted.pem $WORK/home/.ssh/id_rsa
cp rsa-encrypted.pub $WORK/home/.ssh/id_rsa.pub
cp ed25519.pem $WORK/home/.ssh/id_ed25519

# Criterion 5: no TTY, no agent — show key --investigate --json exits 0, reports what is
# derivable (the three public-half-only schemes), and marks aws-created-rsa unknown with the
# exact machine-readable reason.
exec hasp show key id_rsa --investigate --json --key-dir $WORK/home/.ssh
stdout '"kind": "key.show"'
stdout '"scheme": "aws-created-rsa"'
stdout '"confidence": "unknown"'
stdout '"reason": "passphrase-required-no-tty"'
stdout '"scheme": "aws-imported-rsa"'
stdout '"scheme": "ssh-native-sha256"'
stdout '"scheme": "legacy-ssh-md5"'
stdout '"id": "aws-ec2-created"'
stdout '"id": "aws-ec2-imported"'
stdout '"confidence": "possible"'

# The same, human-rendered: every scheme in registry order, the exact unknown reason, and both
# RSA origins.
exec hasp show key id_rsa --investigate --key-dir $WORK/home/.ssh
stdout 'aws-created-rsa\s+unknown\s+unknown\s+passphrase-required-no-tty'
stdout 'aws-imported-rsa'
stdout 'ssh-native-sha256'
stdout 'legacy-ssh-md5'
stdout 'aws-ec2-created\s+possible'
stdout 'aws-ec2-imported\s+possible'

# A non-RSA key: both AWS schemes report scheme-not-applicable (never omitted), and origins is
# empty — never an invented guess for an algorithm neither AWS RSA scheme could ever apply to.
exec hasp show key id_ed25519 --investigate --key-dir $WORK/home/.ssh
stdout 'aws-created-rsa\s+unknown\s+unknown\s+scheme-not-applicable'
stdout 'aws-imported-rsa\s+unknown\s+unknown\s+scheme-not-applicable'
stdout '\(none\)'

# list key --investigate: the plain table first (unchanged shape), then a per-key investigation
# block — both keys present, every scheme for each.
exec hasp list key --investigate --key-dir $WORK/home/.ssh
stdout 'NAME\s+ALGORITHM'
stdout 'Investigation: id_rsa'
stdout 'Investigation: id_ed25519'

# --investigate is a local flag on list key/show key only (tdd.md §9's own text: "absent from
# every other verb×noun cell") — not accepted by an unrelated command.
! exec hasp check key --investigate --key-dir $WORK/home/.ssh
stderr 'unknown flag'

