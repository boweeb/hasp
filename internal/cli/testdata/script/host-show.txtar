env HOME=$WORK/home
mkdir $WORK/home/.ssh
cp key.pem $WORK/home/.ssh/id_ed25519
cp config $WORK/home/.ssh/config

exec hasp show host work --key-dir $WORK/home/.ssh
stdout 'Pattern:\s+work'
stdout 'SHA256:\S+\s+\(explicit\)'

