mkdir $WORK/home/.ssh
cp key.pem $WORK/home/.ssh/id_ed25519

# The real fingerprint is SHA256:t4rn6Go9uzGHCyff1lwYWtX+swf+EQhuqmE2dHSqkFE (from key-list.txtar).
# Mangle its case and inject punctuation — J2's requirement.
exec hasp find key sha256:T4RN-6Go9-uzGH --key-dir $WORK/home/.ssh
stdout 'id_ed25519'

exec hasp find key nonexistentfragment --key-dir $WORK/home/.ssh
stdout '^NAME'
! stdout 'id_ed25519'

