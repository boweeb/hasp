env HOME=$WORK/home
mkdir $WORK/home/.ssh
cp key.pem $WORK/home/.ssh/id_ed25519
cp config $WORK/home/.ssh/config

exec hasp show key id_ed25519 --key-dir $WORK/home/.ssh
stdout 'Name:\s+id_ed25519'
stdout 'work\s+\(explicit\)'
stdout 'other\s+\(implicit-default\)'

! exec hasp show key does-not-exist --key-dir $WORK/home/.ssh
! stdout .
stderr 'not found'

