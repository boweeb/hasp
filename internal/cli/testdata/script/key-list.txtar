mkdir $WORK/home/.ssh
cp key.pem $WORK/home/.ssh/id_ed25519

exec hasp list key --key-dir $WORK/home/.ssh
stdout 'id_ed25519'
stdout 'ssh-ed25519'
stdout 'openssh'

exec hasp list key --key-dir $WORK/home/.ssh --json
stdout '"kind": "key.list"'
stdout '"version": 1'

